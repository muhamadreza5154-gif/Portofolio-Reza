# =====================================================================
#  CONTOH FILE .env
#  1. Copy file ini, lalu ubah namanya menjadi:  .env
#  2. Isi nilainya dari Supabase Dashboard -> Project Settings -> API Keys
#     (lihat PANDUAN.md langkah 5)
# =====================================================================

# Project URL  (contoh: https://abcdefghijk.supabase.co)
VITE_SUPABASE_URL=https://ISI-PROJECT-ID-KAMU.supabase.co

# Publishable key / anon key  (diawali "sb_publishable_..." atau "eyJ...")
VITE_SUPABASE_ANON_KEY=ISI-PUBLISHABLE-KEY-KAMU

# Secret key / service_role key  (diawali "sb_secret_..." atau "eyJ...")
# RAHASIA! Hanya dipakai server untuk menyimpan komentar.
# Wajib diisi di Vercel (Environment Variables). Jangan pernah dibagikan.
SUPABASE_SERVICE_ROLE_KEY=ISI-SECRET-KEY-KAMU
